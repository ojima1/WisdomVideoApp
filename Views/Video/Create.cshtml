@using WisdomVideoApp.Models
@{
    ViewData["Title"] = "Wisdom Video Generator";
    Layout = null;

    // Get styles from ViewBag (set by controller)
    var styles = ViewBag.Styles as List<VideoStyle> ?? new List<VideoStyle>();
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Wisdom Hub — Video Generator</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;1,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
            *, *::before, *::after {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            :root {
                --cream: #F5F0E8;
                --warm-dark: #1C1712;
                --charcoal: #2D2820;
                --ink: #3D3530;
                --amber: #C4862A;
                --amber-light: #E8A94A;
                --muted: #8C7B6B;
                --border: rgba(60,45,30,0.15);
                --progress-bg: #EDE7DC;
            }

            body {
                background-color: var(--cream);
                color: var(--charcoal);
                font-family: 'Inter', sans-serif;
                min-height: 100vh;
                background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23C4862A' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
            }

            .app-wrapper {
                max-width: 820px;
                margin: 0 auto;
                padding: 48px 24px 80px;
            }

            /* Header */
            .header {
                text-align: center;
                margin-bottom: 48px;
            }

            .header-eyebrow {
                font-size: 11px;
                font-weight: 500;
                letter-spacing: 0.18em;
                text-transform: uppercase;
                color: var(--amber);
                margin-bottom: 12px;
            }

            .header h1 {
                font-family: 'Playfair Display', Georgia, serif;
                font-size: clamp(28px, 5vw, 42px);
                font-weight: 600;
                color: var(--warm-dark);
                line-height: 1.2;
            }

                .header h1 em {
                    font-style: italic;
                    font-weight: 400;
                    color: var(--amber);
                }

            .header-sub {
                margin-top: 12px;
                font-size: 15px;
                color: var(--muted);
                font-weight: 300;
                line-height: 1.6;
            }

            .divider {
                width: 48px;
                height: 2px;
                background: var(--amber);
                margin: 20px auto 0;
                opacity: 0.6;
            }

            /* Card */
            .card {
                background: #FDFAF5;
                border: 1px solid var(--border);
                border-radius: 2px;
                padding: 36px;
                box-shadow: 0 2px 20px rgba(60,40,20,0.06), 0 0 0 1px rgba(196,134,42,0.06);
            }

            /* Script area */
            .field-label {
                display: flex;
                justify-content: space-between;
                align-items: baseline;
                margin-bottom: 10px;
            }

                .field-label label {
                    font-size: 12px;
                    font-weight: 500;
                    letter-spacing: 0.1em;
                    text-transform: uppercase;
                    color: var(--ink);
                }

                .field-label .hint {
                    font-size: 12px;
                    color: var(--muted);
                }

            .script-input {
                width: 100%;
                height: 180px;
                background: var(--cream);
                border: 1px solid var(--border);
                border-radius: 2px;
                padding: 16px;
                font-family: 'Inter', sans-serif;
                font-size: 14px;
                line-height: 1.7;
                color: var(--charcoal);
                resize: vertical;
                outline: none;
                transition: border-color 0.2s;
            }

                .script-input:focus {
                    border-color: var(--amber);
                    box-shadow: 0 0 0 3px rgba(196,134,42,0.08);
                }

                .script-input::placeholder {
                    color: var(--muted);
                    opacity: 0.7;
                }

            /* Style selection */
            .style-section {
                margin-top: 20px;
            }

            .style-category-filter {
                display: flex;
                gap: 8px;
                flex-wrap: wrap;
                margin-bottom: 12px;
            }

            .category-chip {
                padding: 4px 14px;
                border: 1px solid var(--border);
                border-radius: 16px;
                font-size: 11px;
                cursor: pointer;
                transition: all 0.15s;
                background: transparent;
                color: var(--muted);
                font-family: 'Inter', sans-serif;
            }

                .category-chip:hover {
                    border-color: var(--amber);
                    color: var(--ink);
                }

                .category-chip.active {
                    background: var(--amber);
                    border-color: var(--amber);
                    color: white;
                }

            .style-grid {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
                gap: 8px;
                max-height: 200px;
                overflow-y: auto;
                padding: 4px 2px;
            }

            .style-card {
                padding: 10px 12px;
                border: 2px solid var(--border);
                border-radius: 2px;
                cursor: pointer;
                transition: all 0.15s;
                background: transparent;
                text-align: left;
            }

                .style-card:hover {
                    border-color: var(--amber);
                    background: rgba(196,134,42,0.04);
                }

                .style-card.selected {
                    border-color: var(--amber);
                    background: rgba(196,134,42,0.08);
                }

                .style-card .style-name {
                    font-size: 12px;
                    font-weight: 500;
                    color: var(--ink);
                }

                .style-card .style-category-tag {
                    font-size: 9px;
                    text-transform: uppercase;
                    letter-spacing: 0.08em;
                    color: var(--muted);
                    background: var(--cream);
                    padding: 1px 8px;
                    border-radius: 10px;
                    display: inline-block;
                    margin-top: 2px;
                }

                .style-card .style-desc {
                    font-size: 10px;
                    color: var(--muted);
                    margin-top: 3px;
                    line-height: 1.4;
                }

            /* Voice selector */
            .voice-row {
                display: flex;
                gap: 10px;
                flex-wrap: wrap;
                margin-top: 20px;
            }

            .voice-chip {
                display: flex;
                align-items: center;
                gap: 7px;
                padding: 7px 14px;
                border: 1px solid var(--border);
                border-radius: 20px;
                font-size: 12px;
                cursor: pointer;
                transition: all 0.15s;
                background: transparent;
                color: var(--ink);
            }

                .voice-chip input {
                    display: none;
                }

                .voice-chip:has(input:checked),
                .voice-chip.active {
                    background: var(--amber);
                    border-color: var(--amber);
                    color: white;
                }

            .voice-dot {
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background: currentColor;
                opacity: 0.6;
            }

            /* Generate button */
            .btn-generate {
                margin-top: 24px;
                width: 100%;
                padding: 15px 24px;
                background: var(--warm-dark);
                color: var(--cream);
                border: none;
                border-radius: 2px;
                font-family: 'Inter', sans-serif;
                font-size: 13px;
                font-weight: 500;
                letter-spacing: 0.08em;
                text-transform: uppercase;
                cursor: pointer;
                transition: all 0.2s;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
            }

                .btn-generate:hover {
                    background: var(--charcoal);
                    transform: translateY(-1px);
                }

                .btn-generate:disabled {
                    opacity: 0.5;
                    cursor: not-allowed;
                    transform: none;
                }

            .btn-icon {
                font-size: 16px;
            }

            /* Progress section */
            .progress-section {
                display: none;
                margin-top: 32px;
            }

                .progress-section.visible {
                    display: block;
                }

            .progress-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 10px;
            }

            .progress-step {
                font-size: 13px;
                color: var(--ink);
                font-weight: 500;
            }

            .progress-pct {
                font-size: 12px;
                color: var(--amber);
                font-weight: 500;
            }

            .progress-bar-track {
                height: 3px;
                background: var(--progress-bg);
                border-radius: 2px;
                overflow: hidden;
            }

            .progress-bar-fill {
                height: 100%;
                background: linear-gradient(90deg, var(--amber), var(--amber-light));
                border-radius: 2px;
                transition: width 0.4s ease;
                width: 0%;
            }

            .progress-statement {
                margin-top: 10px;
                font-size: 12px;
                color: var(--muted);
                font-style: italic;
                min-height: 18px;
            }

            /* Log */
            .log-area {
                margin-top: 16px;
                background: var(--cream);
                border: 1px solid var(--border);
                border-radius: 2px;
                padding: 14px;
                max-height: 140px;
                overflow-y: auto;
                font-size: 12px;
                color: var(--muted);
                line-height: 1.6;
            }

            .log-entry {
                padding: 1px 0;
            }

                .log-entry.success {
                    color: #5A8A5A;
                }

                .log-entry.error {
                    color: #A04040;
                }

            /* Result */
            .result-section {
                display: none;
                margin-top: 32px;
                text-align: center;
            }

                .result-section.visible {
                    display: block;
                }

            .result-card {
                background: #F0EDE5;
                border: 1px solid rgba(196,134,42,0.25);
                border-radius: 2px;
                padding: 32px;
            }

            .result-icon {
                font-size: 40px;
                margin-bottom: 12px;
            }

            .result-title {
                font-family: 'Playfair Display', serif;
                font-size: 22px;
                color: var(--warm-dark);
                margin-bottom: 6px;
            }

            .result-sub {
                font-size: 13px;
                color: var(--muted);
                margin-bottom: 24px;
            }

            video {
                width: 100%;
                border-radius: 2px;
                margin-bottom: 20px;
                box-shadow: 0 4px 20px rgba(60,40,20,0.12);
            }

            .result-actions {
                display: flex;
                justify-content: center;
                gap: 12px;
                flex-wrap: wrap;
            }

            .btn-download {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                padding: 12px 28px;
                background: var(--amber);
                color: white;
                text-decoration: none;
                border-radius: 2px;
                font-size: 13px;
                font-weight: 500;
                letter-spacing: 0.06em;
                text-transform: uppercase;
                transition: all 0.2s;
            }

                .btn-download:hover {
                    background: #B5781F;
                    transform: translateY(-1px);
                }

            .btn-new {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                padding: 12px 28px;
                background: transparent;
                color: var(--ink);
                border: 1px solid var(--border);
                border-radius: 2px;
                font-size: 13px;
                font-weight: 500;
                letter-spacing: 0.06em;
                text-transform: uppercase;
                cursor: pointer;
                transition: all 0.2s;
            }

                .btn-new:hover {
                    border-color: var(--amber);
                    color: var(--amber);
                }

            .result-style-badge {
                display: inline-block;
                padding: 4px 14px;
                background: var(--cream);
                border: 1px solid var(--border);
                border-radius: 12px;
                font-size: 11px;
                color: var(--muted);
                margin-bottom: 16px;
            }

            /* Tips */
            .tips {
                margin-top: 32px;
                padding: 20px;
                border-left: 2px solid var(--amber);
                background: rgba(196,134,42,0.04);
            }

            .tips-title {
                font-size: 11px;
                font-weight: 500;
                letter-spacing: 0.12em;
                text-transform: uppercase;
                color: var(--amber);
                margin-bottom: 10px;
            }

            .tips ul {
                list-style: none;
                padding: 0;
            }

            .tips li {
                font-size: 13px;
                color: var(--muted);
                padding: 3px 0;
                padding-left: 14px;
                position: relative;
                line-height: 1.5;
            }

                .tips li::before {
                    content: '—';
                    position: absolute;
                    left: 0;
                    color: var(--amber);
                    opacity: 0.5;
                }

            @@media (max-width: 600px) {
                .card {
                    padding: 20px;
                }

                .style-grid {
                    grid-template-columns: 1fr 1fr;
                }

                .style-card {
                    padding: 8px 10px;
                }
            }
    </style>
</head>
<body>
    <div class="app-wrapper">

        <header class="header">
            <p class="header-eyebrow">Wisdom Hub</p>
            <h1>Turn words into<br><em>videos</em>, effortlessly</h1>
            <p class="header-sub">Paste your script, choose a style — get a fully produced video with AI images and voiceover.</p>
            <div class="divider"></div>
        </header>

        <div class="card">
            <div class="field-label">
                <label>Your Script</label>
                <span class="hint">One statement per line</span>
            </div>
            <textarea id="scriptInput"
                      class="script-input"
                      placeholder="The problem isn't that you're not doing enough.
            You are enough. You always were.
            Stop running from the version of you that needs love.
            What if rest was the answer you were looking for?"></textarea>

            <!-- Style Selection -->
            <div class="style-section">
                <div class="field-label">
                    <label>Visual Style</label>
                    <span class="hint">Select a style for your video</span>
                </div>

                <!-- Category filter -->
                <div class="style-category-filter" id="categoryFilter">
                    <button class="category-chip active" data-category="all">All</button>
                    @foreach (var cat in categories)
                    {
                        <button class="category-chip" data-category="@cat">@cat</button>
                    }
                </div>

                <!-- Style grid -->
                <div class="style-grid" id="styleGrid">
                    @foreach (var style in styles)
                    {
                        <div class="style-card @(style.Id == "doodle-handdrawn" ? "selected" : "")"
                             data-style-id="@style.Id"
                             data-category="@style.Category"
                             onclick="selectStyle('@style.Id')">
                            <div class="style-name">@style.Name</div>
                            <span class="style-category-tag">@style.Category</span>
                            <div class="style-desc">@style.Description</div>
                        </div>
                    }
                </div>
            </div>

            <div class="field-label" style="margin-top: 20px; margin-bottom: 0;">
                <label>Voice</label>
                <span class="hint">All free · Microsoft Neural</span>
            </div>
            <div class="voice-row" id="voiceGroup">
                <label class="voice-chip active">
                    <input type="radio" name="voice" value="en-US-AriaNeural" checked>
                    <span class="voice-dot"></span> Aria — Warm & Expressive
                </label>
                <label class="voice-chip">
                    <input type="radio" name="voice" value="en-US-JennyNeural">
                    <span class="voice-dot"></span> Jenny — Friendly
                </label>
                <label class="voice-chip">
                    <input type="radio" name="voice" value="en-US-GuyNeural">
                    <span class="voice-dot"></span> Guy — Deep & Calm
                </label>
                <label class="voice-chip">
                    <input type="radio" name="voice" value="en-GB-SoniaNeural">
                    <span class="voice-dot"></span> Sonia — British
                </label>
            </div>

            <button class="btn-generate" id="generateBtn" onclick="startGeneration()">
                <span class="btn-icon">✦</span> Generate Video
            </button>

            <!-- Progress -->
            <div class="progress-section" id="progressSection">
                <div class="progress-header">
                    <span class="progress-step" id="progressStep">Starting...</span>
                    <span class="progress-pct" id="progressPct">0%</span>
                </div>
                <div class="progress-bar-track">
                    <div class="progress-bar-fill" id="progressBar"></div>
                </div>
                <div class="progress-statement" id="progressStatement"></div>
                <div class="log-area" id="logArea"></div>
            </div>
        </div>

        <!-- Result -->
        <div class="result-section" id="resultSection">
            <div class="result-card">
                <div class="result-icon">✦</div>
                <div class="result-title">Your video is ready</div>
                <div class="result-sub">Click play to preview, or download for CapCut/YouTube.</div>
                <div class="result-style-badge" id="resultStyleBadge">Style: Hand-Drawn Doodle</div>
                <video id="resultVideo" controls></video>
                <br>
                <div class="result-actions">
                    <a id="downloadLink" class="btn-download" download="wisdom_video.mp4">⬇ Download MP4</a>
                    <button class="btn-new" onclick="resetApp()">↺ New Video</button>
                </div>
            </div>
        </div>

        <div class="tips">
            <div class="tips-title">Tips for great videos</div>
            <ul>
                <li>Write one complete thought per line — each line becomes one scene</li>
                <li>Aria voice works best for emotional/relationship content</li>
                <li>Keep lines between 8–20 words for natural pacing</li>
                <li>5–10 lines gives you a perfect 60–90 second video</li>
                <li>Try different visual styles for different moods and topics</li>
            </ul>
        </div>

    </div>

    <script>
            // Track selected style
            let selectedStyleId = '@(styles.FirstOrDefault()?.Id ?? "doodle-handdrawn")';

            // Voice chip UI
            document.querySelectorAll('.voice-chip input').forEach(input => {
                input.addEventListener('change', () => {
                    document.querySelectorAll('.voice-chip').forEach(c => c.classList.remove('active'));
                    input.closest('.voice-chip').classList.add('active');
                });
            });

            // Category filter
            document.querySelectorAll('.category-chip').forEach(chip => {
                chip.addEventListener('click', function() {
                    document.querySelectorAll('.category-chip').forEach(c => c.classList.remove('active'));
                    this.classList.add('active');

                    const category = this.dataset.category;
                    const cards = document.querySelectorAll('.style-card');

                    cards.forEach(card => {
                        if (category === 'all' || card.dataset.category === category) {
                            card.style.display = 'block';
                        } else {
                            card.style.display = 'none';
                        }
                    });
                });
            });

            // Select style
            function selectStyle(styleId) {
                selectedStyleId = styleId;
                document.querySelectorAll('.style-card').forEach(c => c.classList.remove('selected'));
                document.querySelector(`.style-card[data-style-id="${styleId}"]`).classList.add('selected');
            }

            function addLog(msg, type = '') {
                const log = document.getElementById('logArea');
                const div = document.createElement('div');
                div.className = `log-entry ${type}`;
                div.textContent = `${new Date().toLocaleTimeString()} — ${msg}`;
                log.appendChild(div);
                log.scrollTop = log.scrollHeight;
            }

            function startGeneration() {
                const script = document.getElementById('scriptInput').value.trim();
                if (!script) { alert('Please enter your script first.'); return; }

                const voice = document.querySelector('input[name="voice"]:checked').value;
                const style = selectedStyleId;

                document.getElementById('generateBtn').disabled = true;
                document.getElementById('progressSection').classList.add('visible');
                document.getElementById('resultSection').classList.remove('visible');
                document.getElementById('logArea').innerHTML = '';

                addLog('Starting video generation pipeline...');
                addLog(`Selected style: ${document.querySelector(`.style-card[data-style-id="${style}"]`)?.querySelector('.style-name')?.textContent || style}`);

                const params = new URLSearchParams({
                    script,
                    voice,
                    style // Add style to the parameters
                });

                const evtSource = new EventSource(`/Video/Generate?${params}`);

                evtSource.addEventListener('progress', e => {
                    const data = JSON.parse(e.data);
                    document.getElementById('progressStep').textContent = data.step;
                    document.getElementById('progressPct').textContent = `${data.percent}%`;
                    document.getElementById('progressBar').style.width = `${data.percent}%`;
                    if (data.currentStatement) {
                        document.getElementById('progressStatement').textContent = `"${data.currentStatement}"`;
                    }
                    addLog(data.step);
                });

                evtSource.addEventListener('complete', e => {
                    evtSource.close();
                    const data = JSON.parse(e.data);
                    addLog('Video generated successfully!', 'success');
                    showResult(data.videoUrl, data.styleUsed);
                });

                evtSource.addEventListener('error', e => {
                    evtSource.close();
                    try {
                        const data = JSON.parse(e.data);
                        addLog(`Error: ${data.message}`, 'error');
                    } catch {
                        addLog('An unexpected error occurred.', 'error');
                    }
                    document.getElementById('generateBtn').disabled = false;
                });

                // Fallback timeout
                setTimeout(() => {
                    if (evtSource.readyState !== EventSource.CLOSED) {
                        evtSource.close();
                        addLog('Connection timeout. Please try again.', 'error');
                        document.getElementById('generateBtn').disabled = false;
                    }
                }, 600000); // 10 minutes timeout
            }

            function showResult(videoUrl, styleUsed) {
                document.getElementById('generateBtn').disabled = false;
                document.getElementById('resultSection').classList.add('visible');
                document.getElementById('resultVideo').src = videoUrl;
                document.getElementById('downloadLink').href = videoUrl;

                // Show which style was used
                if (styleUsed) {
                    document.getElementById('resultStyleBadge').textContent = `Style: ${styleUsed}`;
                }

                document.getElementById('resultSection').scrollIntoView({ behavior: 'smooth' });
            }

            function resetApp() {
                document.getElementById('resultSection').classList.remove('visible');
                document.getElementById('progressSection').classList.remove('visible');
                document.getElementById('progressBar').style.width = '0%';
                document.getElementById('progressStep').textContent = 'Starting...';
                document.getElementById('progressPct').textContent = '0%';
                document.getElementById('progressStatement').textContent = '';
                document.getElementById('scriptInput').value = '';
                document.getElementById('scriptInput').focus();

                // Reset to default style
                const defaultStyle = '@(styles.FirstOrDefault()?.Id ?? "doodle-handdrawn")';
                selectStyle(defaultStyle);
            }
    </script>
</body>
</html>